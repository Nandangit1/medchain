# Dependencies are installed inside the image, never copied in.
**/node_modules

# Secrets must come from the runtime environment, not the image layers.
**/.env
**/.env.*
!**/.env.example

# Build output and local state
**/dist
**/build
**/coverage
.local
**/.local
**/logs
**/*.log

# Blockchain build artefacts — regenerated by the deployer service
blockchain/artifacts
blockchain/cache
blockchain/deployments
backend/src/config/contracts

# Repository and editor noise
.git
.gitignore
.vscode
.idea
**/.DS_Store
Thumbs.db

# Documentation is not needed at runtime
docs
*.md
!README.md
scripts
