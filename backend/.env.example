NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/blockchain_telemedicine

JWT_SECRET=change_this_to_a_long_random_secret_with_at_least_32_characters
JWT_EXPIRES_IN=1d

# Comma-separated allow-list. The dev server proxies /api, so the browser is
# normally same-origin and never triggers CORS — this covers direct API access.
# http://localhost:3000 is the Vite dev server; http://localhost is the
# single-server production mode on port 80.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://medchain.local,http://medchain.local:3000

# Canonical public URL, used for links a USER clicks (password-reset emails).
# Separate from CORS_ORIGIN, which is a SET of origins — a link needs exactly
# one. Defaults to the first CORS origin, which is right for local development.
APP_URL=http://localhost:3000

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# --- Module 3: storage and encryption ---

# Master key used to wrap every per-file content key. Must be 32 bytes encoded
# as exactly 64 hexadecimal characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored medical record permanently unreadable.
FILE_ENCRYPTION_KEY=replace_with_64_hex_characters

# Storage backend selected by the IPFS service factory.
#   local  = content-addressed storage on disk, no credentials required
#   pinata = real IPFS pinning through Pinata, requires PINATA_JWT
IPFS_DRIVER=local
LOCAL_IPFS_PATH=./.local/ipfs

# Required only when IPFS_DRIVER=pinata
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# --- Module 4: blockchain ---

# When false, the API runs exactly as it did in Module 3: records are stored and
# encrypted normally but stay at blockchain.status "pending". Enable it, then run
# `npm run backfill:anchors` to anchor everything retrospectively.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONFIRMATIONS=1

# Populated by the deployment script.
CONTRACT_ADDRESS=

# The backend service wallet. Holds REGISTRAR_ROLE and pays gas for every
# transaction. On a live network this must be a dedicated, funded key.
REGISTRAR_PRIVATE_KEY=

# Derives each user's deterministic on-chain identity address. 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it re-points every existing user at a new address, orphaning their
# on-chain history. Set it once and back it up.
CUSTODIAL_WALLET_SEED=

# --- Mail ---
# Outbound email is opt-in. Left false, every message is written to the
# application log instead of sent — password reset stays recoverable on a
# machine with no SMTP account, and the tests need no mail server.
#
# Brevo (free, 300/day):  smtp-relay.brevo.com : 587
# Gmail:                  smtp.gmail.com : 587  with an App Password,
#                         NOT your account password.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MedChain <no-reply@medchain.local>

# --- Two-factor authentication ---
# Roles prompted to enrol. Enforcement is separate and off by default so that
# turning MFA on cannot lock a deployment out of its own admin account.
MFA_REQUIRED_ROLES=doctor,admin
MFA_ENFORCED=false

# --- Video consultation ---
# Host serving the Jitsi conference. Point at a self-hosted deployment to keep
# consultation media inside your own infrastructure.
JITSI_DOMAIN=meet.jit.si

# --- ABDM / ABHA ---
# mock = validates format and Verhoeff checksum offline; never claims an
#        identity was actually verified.
# nha  = the real ABDM gateway; needs a registered NHA sandbox client.
ABHA_DRIVER=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# --- Ambient scribe ---
# mock   = rule-based extraction from the transcript, offline, invents nothing.
# claude = structuring via the Anthropic API; needs ANTHROPIC_API_KEY.
# Either way a clinician reviews and signs before anything is stored.
SCRIBE_DRIVER=mock
ANTHROPIC_API_KEY=
