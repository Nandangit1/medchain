{
  "name": "blockchain-telemedicine-backend",
  "version": "1.0.0",
  "description": "Backend API for the Blockchain-Based Secure Telemedicine System.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "//start:site": "Serves frontend/dist and the API from one port. Run the frontend build first.",
    "start:site": "node src/site.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "//ensure:indexes": "Builds every schema-declared index. Run once against a managed cluster before setting DISABLE_AUTO_INDEX=true.",
    "ensure:indexes": "node src/scripts/ensureIndexes.js",
    "backfill:anchors": "node src/scripts/backfillAnchors.js",
    "test": "node -r dotenv/config --test \"tests/unit.test.js\"",
    "test:unit": "node -r dotenv/config --test \"tests/unit.test.js\"",
    "test:integration": "node -r dotenv/config --test \"tests/*integration.test.js\"",
    "test:all": "node -r dotenv/config --test \"tests/*.test.js\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json"
  },
  "keywords": [
    "telemedicine",
    "blockchain",
    "mongodb",
    "express",
    "ipfs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "bcrypt": "^6.0.0",
    "circomlibjs": "^0.1.7",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "snarkjs": "^0.7.6",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
