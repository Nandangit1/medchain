# Base path of the backend API.
#
# Leave this RELATIVE for local development. The Vite dev server proxies /api to
# the Express backend, which makes the whole app same-origin — no CORS
# preflights, and the httpOnly refresh cookie works without special cases.
#
# Use an absolute URL only when the frontend and API are deployed to different
# hosts, e.g. VITE_API_URL=https://api.medchain.example.com/api/v1
VITE_API_URL=/api/v1
